# ============================================
# Environment & Secrets
# ============================================
.env
.env.*
!.env.example
!.env.production
!frontend/.env.production

# ============================================
# Python
# ============================================
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.Python
venv/
env/
.venv/

# ============================================
# Node / Frontend
# ============================================
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.cache/
# Accidental root package files (frontend is in ./frontend/)
/package.json
/package-lock.json

# ============================================
# Database files
# ============================================
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# Exception: include the pre-seeded movie repository (47MB, needed for deployment)
!movie_cache.db
# DB backup / recovery artifacts
movie_cache.db.*

# ============================================
# IDE & OS
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ============================================
# JWT secret key file (auto-generated on first run)
# ============================================
backend/jwt_secret.key

# ============================================
# Logs
# ============================================
*.log
logs/
dns_debug.log

# ============================================
# Cache & Generated
# ============================================
image_cache/
.cache/
*.tmp

# ============================================
# Audio files (large, not for git)
# ============================================
audio_files/

# ============================================
# Capacitor native projects (mostly generated)
# ============================================
# NOT: Bir DIZIN yok sayilirsa git icine hic inmez ve alt yollardaki `!` kurallari
# HIC CALISMAZ. Bu yuzden `frontend/android/` yerine icerigi (`/**`) yok sayilir ve
# once tum dizinler geri acilir (`!.../**/`); ancak ondan sonra dosya istisnalari
# islenebilir. Eski hali yuzunden AndroidManifest.xml ve App.entitlements
# "takipli" saniliyordu ama aslinda git tarafindan hic gorulmuyordu.
frontend/android/**
frontend/ios/**
!frontend/android/**/
!frontend/ios/**/
# Keep native customizations tracked:
!frontend/android/app/src/main/AndroidManifest.xml
!frontend/android/app/src/main/res/**
!frontend/ios/App/App/Info.plist
!frontend/ios/App/App/App.entitlements
